rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(familyId, userId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(userId);
    }

    function isApprovedMember(familyId) {
      return signedIn()
        && exists(memberPath(familyId, request.auth.uid))
        && get(memberPath(familyId, request.auth.uid)).data.status == 'approved';
    }

    function hasRole(familyId, allowedRoles) {
      return isApprovedMember(familyId)
        && get(memberPath(familyId, request.auth.uid)).data.role in allowedRoles;
    }

    function canEditPeople(familyId) {
      return hasRole(familyId, ['owner', 'admin', 'contributor']);
    }

    function canManageFamily(familyId) {
      return hasRole(familyId, ['owner', 'admin']);
    }

    function validPerson(person) {
      return person.keys().hasAll([
          'fullName', 'tamilName', 'gender', 'birthYear', 'lifeStatus', 'generation',
          'branch', 'place', 'familyRole', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && person.keys().hasOnly([
          'fullName', 'tamilName', 'gender', 'birthYear', 'lifeStatus', 'generation',
          'branch', 'place', 'familyRole', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && person.fullName is string
        && person.fullName.size() > 0
        && person.gender in ['male', 'female', 'other', 'unknown']
        && person.lifeStatus in ['living', 'deceased', 'unknown']
        && person.generation is int
        && person.generation >= 1
        && person.branch is string
        && person.createdBy is string;
    }

    match /families/{familyId} {
      allow read: if isApprovedMember(familyId);
      // Family creation, membership grants, and role changes are provisioned by an owner.
      allow create, update, delete: if false;

      match /pending_users/{requestId} {
        // Each signed-in user can create and read only their own request.
        allow get: if (signedIn() && requestId == request.auth.uid) || canManageFamily(familyId);
        allow list: if canManageFamily(familyId);
        allow create: if signedIn()
          && requestId == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.role == 'member'
          && request.resource.data.status == 'pending';
        allow update: if canManageFamily(familyId)
          || (signedIn()
            && requestId == request.auth.uid
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['pending', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'status', 'updatedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'pending');
        allow delete: if canManageFamily(familyId);
      }

      match /members/{memberId} {
        allow get: if signedIn() && memberId == request.auth.uid
          || (isApprovedMember(familyId) && canManageFamily(familyId));
        allow list: if canManageFamily(familyId);
        // Owners/admins can approve only regular members or contributors, never grant admin/owner roles here.
        allow create, update: if canManageFamily(familyId)
          && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'approvedBy', 'approvedAt', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'approvedBy', 'approvedAt', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.role in ['member', 'contributor']
          && request.resource.data.status == 'approved'
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /people/{personId} {
        allow read: if isApprovedMember(familyId);
        allow create: if canEditPeople(familyId)
          && validPerson(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEditPeople(familyId)
          && validPerson(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canManageFamily(familyId);
      }

      match /relationships/{relationshipId} {
        allow read: if isApprovedMember(familyId);
        allow create: if canManageFamily(familyId)
          && request.resource.data.keys().hasAll(['fromId', 'toId', 'relationshipType', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['fromId', 'toId', 'relationshipType', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.fromId is string
          && request.resource.data.toId is string
          && request.resource.data.fromId != request.resource.data.toId
          && request.resource.data.relationshipType in ['parent', 'spouse']
          && request.resource.data.status == 'approved'
          && request.resource.data.createdBy == request.auth.uid
          && exists(/databases/$(database)/documents/families/$(familyId)/people/$(request.resource.data.fromId))
          && exists(/databases/$(database)/documents/families/$(familyId)/people/$(request.resource.data.toId));
        allow update: if canManageFamily(familyId)
          && request.resource.data.keys().hasAll(['fromId', 'toId', 'relationshipType', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['fromId', 'toId', 'relationshipType', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.fromId is string
          && request.resource.data.toId is string
          && request.resource.data.fromId != request.resource.data.toId
          && request.resource.data.relationshipType in ['parent', 'spouse']
          && request.resource.data.status == 'approved'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && exists(/databases/$(database)/documents/families/$(familyId)/people/$(request.resource.data.fromId))
          && exists(/databases/$(database)/documents/families/$(familyId)/people/$(request.resource.data.toId));
        allow delete: if canManageFamily(familyId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
